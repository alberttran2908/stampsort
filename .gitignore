# File gói gốc: quá lớn, không commit
*.apk
*.xapk
*.apks
*.aab
# Bản giải nén APK: commit được, nhưng bỏ native libs (không cần cho game design, rất nặng)
research/raw/**/lib/
research/raw/**/*.so
research/apk/*/extracted/lib/
__pycache__/
.venv/
# Video gameplay tham khảo: giữ ở máy, không push (quá lớn)
research/video/*.mp4
research/video/*.mkv
research/video/*.mov
# Art/audio export từ APK đối thủ: chỉ để tham khảo trên máy, không push
research/apk/*/assets_export/
# Frame/sheet cắt từ video gameplay: dựng lại được bằng ffmpeg
research/video/frames/
research/video/sheets/
research/video/key/
# Art/audio tạm từ APK cho prototype (build bằng tools/build_proto_assets.py)
prototype/stamp/assets/
